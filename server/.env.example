# Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fluentfriend?retryWrites=true&w=majority

# Long random string (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed to call this API (comma separated, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Cookie SameSite policy: lax (same-site / proxied deployments), none (frontend and API on different sites; requires HTTPS)
# Defaults: lax in development, none in production.
# COOKIE_SAMESITE=lax

# ---- AI provider (choose one) ----
# anthropic | openai  ("openai" works with any OpenAI-compatible chat completions API)
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Conversation context limits
AI_HISTORY_LIMIT=16
AI_TIMEOUT_MS=25000

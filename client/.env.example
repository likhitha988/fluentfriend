# Optional. Leave unset to call the API on the same origin ("/api"):
#  - in development Vite proxies /api to http://localhost:4000
#  - in production vercel.json rewrites /api to your Render service (recommended: cookies stay first-party)
#
# Only set this if you want the browser to call the API on a different domain directly.
# That requires COOKIE_SAMESITE=none on the server and may be blocked by browsers that block third-party cookies.
# VITE_API_URL=https://your-service.onrender.com/api
